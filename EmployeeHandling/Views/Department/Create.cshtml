@model EmployeeHandling.Dto.DepartmentModel.AddDepartmentDto

@{
    ViewData["Title"] = "Create Department";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="text-center mb-5 animate__animated animate__fadeInDown">
                <div class="d-inline-block p-3 mb-3 rounded-circle" style="background: linear-gradient(135deg, #4e73df20, #1cc88a20);">
                    <i class="bi bi-building text-gradient fs-1"></i>
                </div>
                <h1 class="fw-bold text-gradient display-6 mb-2">Create New Department</h1>
                <p class="text-muted lead">Add a new department to organize and manage your team structure</p>
            </div>

            <div class="card border-0 shadow-3d rounded-4 overflow-hidden animate__animated animate__fadeInUp">
                <div class="card-header text-white position-relative overflow-hidden py-4 px-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #4e73df 100%);">
                    <div class="position-absolute top-0 end-0 w-100 h-100 opacity-10">
                        <div class="pattern-dots" style="transform: rotate(45deg);"></div>
                    </div>
                    <div class="position-relative z-2">
                        <h4 class="mb-0 fw-bold"><i class="bi bi-plus-circle-fill me-2"></i> Department Information</h4>
                        <small class="opacity-75">Fill in the details below to create a new department</small>
                    </div>
                </div>

                <div class="card-body p-5">
                    <form asp-action="Create" method="post" id="createForm">
                        @Html.AntiForgeryToken()

                        <div class="form-group floating-label-group mb-4">
                            <input asp-for="Name" class="form-control form-control-lg shadow-sm floating-input"
                                   placeholder=" " autocomplete="off" id="departmentName" required />
                            <label asp-for="Name" class="floating-label">
                                <i class="bi bi-building me-2"></i>Department Name
                            </label>
                            <div class="form-text">Enter a unique name for the department</div>
                            <span asp-validation-for="Name" class="text-danger validation-message"></span>
                            <div class="input-feedback"></div>
                        </div>

                        <div class="d-flex justify-content-end mb-4">
                            <small class="text-muted">
                                <span id="charCount">0</span>/50 characters
                            </small>
                        </div>

                        

                        <div class="d-flex justify-content-between align-items-center pt-4 border-top">
                            <a class="btn btn-outline-secondary btn-lg px-4 rounded-pill shadow-sm hover-lift"
                               href="@Url.Action("FrontPage", "Department")">
                                <i class="bi bi-arrow-left me-2"></i> Back to List
                            </a>

                            <div class="btn-group" role="group">
                                <button type="reset" class="btn btn-light btn-lg px-4 rounded-pill shadow-sm hover-lift">
                                    <i class="bi bi-arrow-clockwise me-2"></i> Reset
                                </button>
                                <button type="submit" class="btn btn-gradient btn-lg px-5 rounded-pill shadow-lg hover-lift" id="submitBtn">
                                    <i class="bi bi-plus-circle me-2"></i> Create Department
                                    <span class="spinner-border spinner-border-sm d-none ms-2" id="loadingSpinner"></span>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-body text-center p-5">
                <div class="success-animation mb-4">
                    <div class="checkmark">
                        <svg class="checkmark__circle" width="100" height="100" viewBox="0 0 100 100">
                            <circle class="checkmark__circle-background" cx="50" cy="50" r="45" fill="none" />
                            <circle class="checkmark__circle-stroke" cx="50" cy="50" r="45" fill="none" />
                            <polyline class="checkmark__check" points="27,50 45,68 72,35" />
                        </svg>
                    </div>
                </div>
                <h4 class="fw-bold text-gradient mb-3">Department Created!</h4>
                <p class="text-muted mb-4">The department has been successfully added to the system.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="@Url.Action("FrontPage", "Department")" class="btn btn-primary px-4 rounded-pill">
                        <i class="bi bi-list me-2"></i>View All Departments
                    </a>
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">
                        Create Another
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #4e73df 100%);
        --success-gradient: linear-gradient(135deg, #1cc88a 0%, #17a673 100%);
        --shadow-color: rgba(102, 126, 234, 0.1);
    }

    .shadow-3d {
        box-shadow: 0 10px 40px rgba(0,0,0,0.08), 0 5px 15px rgba(0,0,0,0.05), inset 0 0 1px rgba(255,255,255,0.5);
    }

    .text-gradient {
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .floating-label-group {
        position: relative;
        margin-top: 1.5rem;
    }

    .floating-input {
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        background: white;
    }

        .floating-input:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
            transform: translateY(-2px);
        }

            .floating-input:focus + .floating-label,
            .floating-input:not(:placeholder-shown) + .floating-label {
                top: -12px;
                left: 15px;
                font-size: 0.85rem;
                color: #667eea;
                background: white;
                padding: 0 8px;
                font-weight: 600;
            }

    .floating-label {
        position: absolute;
        top: 1rem;
        left: 1.25rem;
        color: #6c757d;
        transition: all 0.3s ease;
        pointer-events: none;
        background: transparent;
    }

    .btn-gradient {
        background: var(--success-gradient);
        border: none;
        color: white;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
    }

        .btn-gradient:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(28, 200, 138, 0.3);
            color: white;
        }

    .hover-lift:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.12) !important;
    }

    .pattern-dots {
        background-image: radial-gradient(circle, rgba(255,255,255,0.3) 2px, transparent 2px);
        background-size: 40px 40px;
        width: 100%;
        height: 100%;
    }

    .success-animation {
        display: flex;
        justify-content: center;
    }

    .checkmark {
        width: 100px;
        height: 100px;
    }

    .checkmark__circle {
        stroke-dasharray: 166;
        stroke-dashoffset: 166;
        stroke-width: 2;
        stroke-miterlimit: 10;
        stroke: #1cc88a;
        fill: none;
        animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
    }

    .checkmark__circle-background {
        fill: rgba(28, 200, 138, 0.1);
    }

    .checkmark__check {
        transform-origin: 50% 50%;
        stroke-dasharray: 48;
        stroke-dashoffset: 48;
        animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards;
        stroke: #1cc88a;
        stroke-width: 3;
    }

    .validation-message {
        display: block;
        margin-top: 8px;
        font-size: 0.875rem;
        animation: fadeIn 0.3s ease-in-out;
    }

    .input-feedback {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .floating-input:valid ~ .input-feedback {
        opacity: 1;
        color: #1cc88a;
    }

    .floating-input:invalid ~ .input-feedback {
        opacity: 1;
        color: #e74a3b;
    }

    #charCount {
        font-weight: 600;
        color: #667eea;
    }

    .floating-input.is-valid {
        border-color: #1cc88a !important;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%231cc88a' d='M2.3 6.73L.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(.375em + .1875rem) center;
        background-size: calc(.75em + .375rem) calc(.75em + .375rem);
    }

    .floating-input.is-invalid {
        border-color: #e74a3b !important;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23e74a3b'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23e74a3b' stroke='none'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(.375em + .1875rem) center;
        background-size: calc(.75em + .375rem) calc(.75em + .375rem);
    }

    .floating-label::after {
        content: " *";
        color: #e74a3b;
    }

    .validation-message {
        display: block;
        margin-top: 8px;
        font-size: 0.875rem;
        animation: fadeIn 0.3s ease-in-out;
    }

    @@media (max-width: 768px) {
        .card-body

    {
        padding: 2rem !important;
    }

    .btn-group {
        width: 100%;
        flex-direction: column;
        gap: 1rem;
    }

        .btn-group .btn {
            width: 100%;
        }

    }

    @@keyframes stroke {
        100% {
            stroke-dashoffset: 0;
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const nameInput = document.getElementById('departmentName');
            const charCount = document.getElementById('charCount');

            if (nameInput && charCount) {
                nameInput.addEventListener('input', function() {
                    charCount.textContent = this.value.length;

                    if (this.value.length > 40) {
                        charCount.style.color = '#e74a3b';
                    } else if (this.value.length > 30) {
                        charCount.style.color = '#f6c23e';
                    } else {
                        charCount.style.color = '#667eea';
                    }
                });
            }

            const form = document.getElementById('createForm');
            const submitBtn = document.getElementById('submitBtn');
            const loadingSpinner = document.getElementById('loadingSpinner');

            if (form) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();

                    if (!form.checkValidity()) {
                        e.stopPropagation();
                        form.classList.add('was-validated');

                        const invalidFields = form.querySelectorAll(':invalid');
                        invalidFields.forEach(field => {
                            field.classList.add('animate__animated', 'animate__headShake');
                            setTimeout(() => {
                                field.classList.remove('animate__animated', 'animate__headShake');
                            }, 1000);
                        });

                        return false;
                    }

                    submitBtn.disabled = true;
                    loadingSpinner.classList.remove('d-none');
                    submitBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i> Creating Department...';

                    // REMOVE the setTimeout and submit the form for real
                    form.submit();
                });
            }

            const floatingInput = document.querySelector('.floating-input');
            const inputFeedback = document.querySelector('.input-feedback');

            if (floatingInput && inputFeedback) {
                floatingInput.addEventListener('input', function() {
                    if (this.validity.valid) {
                        inputFeedback.innerHTML = '<i class="bi bi-check-circle-fill"></i>';
                    } else {
                        inputFeedback.innerHTML = '<i class="bi bi-exclamation-circle-fill"></i>';
                    }
                });

                floatingInput.addEventListener('blur', function() {
                    if (this.value.trim() === '') {
                        this.classList.add('is-invalid');
                        this.classList.remove('is-valid');
                    } else {
                        this.classList.remove('is-invalid');
                        this.classList.add('is-valid');
                    }
                });
            }

            const patternHtml = `
                <div class="position-absolute top-0 end-0 w-100 h-100 opacity-10">
                    <div class="pattern-dots" style="transform: rotate(45deg);"></div>
                </div>
            `;
            const cardHeader = document.querySelector('.card-header');
            if (cardHeader) {
                cardHeader.innerHTML += patternHtml;
            }

            const resetBtn = form.querySelector('button[type="reset"]');
            if (resetBtn) {
                resetBtn.addEventListener('click', function() {
                    form.classList.remove('was-validated');
                    if (charCount) {
                        charCount.textContent = '0';
                        charCount.style.color = '#667eea';
                    }

                    const inputs = form.querySelectorAll('.form-control');
                    inputs.forEach(input => {
                        input.classList.remove('is-valid', 'is-invalid');
                    });

                    if (inputFeedback) {
                        inputFeedback.innerHTML = '';
                    }
                });
            }
        });
    </script>

}