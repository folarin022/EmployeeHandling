@model EmployeeHandling.Dto.DepartmentModel.AddDepartmentDto

@{
    ViewData["Title"] = "Create Department";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg rounded-4 border-0 overflow-hidden">
                <div class="card-header text-white text-center py-3" style="background: linear-gradient(135deg, #4e73df, #1cc88a);">
                    <h4 class="mb-0"><i class="bi bi-building me-2"></i> Create Department</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control form-control-lg shadow-sm" placeholder="Enter department name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a class="btn btn-outline-secondary btn-lg shadow-sm" href="@Url.Action("FrontPage", "Department")">
                                <i class="bi bi-arrow-left me-2"></i> Back
                            </a>
                            <button type="submit" class="btn btn-gradient btn-lg shadow-sm text-white">
                                <i class="bi bi-plus-circle me-2"></i> Add Department
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Card hover effect */
    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        }

    .form-control {
        border-radius: 12px;
        border: 1px solid #ddd;
        transition: box-shadow 0.2s, border-color 0.2s;
    }

        .form-control:focus {
            border-color: #1cc88a;
            box-shadow: 0 0 8px rgba(28,200,138,0.3);
        }

    .btn-gradient {
        background: linear-gradient(135deg, #1cc88a 0%, #17a673 100%);
        border: none;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(28,200,138,0.4);
        }

    .btn i {
        vertical-align: middle;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
}
