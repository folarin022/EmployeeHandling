@model EmployeeHandling.Dto.DepartmentModel.DepartmentDto

@{
    ViewData["Title"] = "Department Details";
}

<div class="container mt-5">
    <div class="card shadow-lg rounded-4 border-0">
        <div class="card-header bg-gradient-success text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-building me-2"></i> Department Details</h4>
            <span class="badge bg-light text-success fs-6">@Model.Name</span>
        </div>

        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3">
                        <h6 class="text-muted"><i class="bi bi-hash me-1"></i> Department ID</h6>
                        <p class="mb-0">@Model.Id</p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3">
                        <h6 class="text-muted"><i class="bi bi-building me-1"></i> Department Name</h6>
                        <p class="mb-0">@Model.Name</p>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-end gap-2">
                <a asp-action="FrontPage" class="btn btn-secondary shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>

                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning shadow-sm">
                    <i class="bi bi-pencil-square me-1"></i> Edit
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
}

<style>
    .bg-gradient-success {
        background: linear-gradient(135deg, #28a745, #1e7e34);
    }

    .card-body h6 {
        font-weight: 600;
        font-size: 0.9rem;
    }

    .card-body p {
        font-size: 1rem;
        margin-bottom: 0;
    }

    .btn i {
        vertical-align: middle;
    }
</style>
