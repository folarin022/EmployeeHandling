@model EmployeeHandling.Dto.EmployeeModel.EditEmployeeDto

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg rounded-5 border-0">
                <div class="card-header bg-gradient-warning text-dark text-center py-4 rounded-top-5">
                    <h3 class="mb-0"><i class="bi bi-pencil-square me-2"></i> Edit Employee</h3>
                </div>
                <div class="card-body p-5">
                    <form asp-action="EditEmployee" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="row g-4">
                            <div class="col-md-6 form-floating">
                                <input asp-for="FirstName" class="form-control form-control-lg" placeholder="First Name" />
                                <label asp-for="FirstName" class="fw-semibold">First Name</label>
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 form-floating">
                                <input asp-for="LastName" class="form-control form-control-lg" placeholder="Last Name" />
                                <label asp-for="LastName" class="fw-semibold">Last Name</label>
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 form-floating">
                                <input asp-for="OtherName" class="form-control form-control-lg" placeholder="Other Name" />
                                <label asp-for="OtherName" class="fw-semibold">Other Name</label>
                                <span asp-validation-for="OtherName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 form-floating">
                                <select asp-for="Gender" class="form-select form-select-lg" aria-label="Gender">
                                    <option value="">-- Select Gender --</option>
                                    <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
                                    <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
                                </select>
                                <label asp-for="Gender" class="fw-semibold">Gender</label>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 form-floating">
                                <input asp-for="Email" class="form-control form-control-lg" placeholder="Email Address" />
                                <label asp-for="Email" class="fw-semibold">Email</label>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 form-floating">
                                <input asp-for="PhoneNumber" class="form-control form-control-lg" placeholder="Phone Number" />
                                <label asp-for="PhoneNumber" class="fw-semibold">Phone Number</label>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-12 form-floating">
                                <input asp-for="Address" class="form-control form-control-lg" placeholder="Address" />
                                <label asp-for="Address" class="fw-semibold">Address</label>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                            <div class="col-12 form-floating">
                                <select asp-for="DepartmentId" class="form-select form-select-lg" asp-items="Model.Departments" aria-label="Department">
                                    <option value="">-- Select Department --</option>
                                </select>
                                <label asp-for="DepartmentId" class="fw-semibold">Department</label>
                                <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-5">
                            <a asp-action="RearPage" class="btn btn-outline-secondary btn-lg shadow-sm">
                                <i class="bi bi-arrow-left me-1"></i> Back
                            </a>
                            <button type="submit" class="btn btn-warning btn-lg shadow-sm text-dark">
                                <i class="bi bi-check-circle me-1"></i> Update
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-warning {
        background: linear-gradient(135deg, #f6c23e, #dda20a);
    }

    .card {
        border-radius: 2rem;
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

    .form-control, .form-select {
        border-radius: 1rem;
        padding: 1rem;
    }

    .form-floating > label {
        color: #495057;
    }

    .btn i {
        vertical-align: middle;
    }

    @@media (max-width: 768px) {
        .card-body

    {
        padding: 2rem;
    }

    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
}
