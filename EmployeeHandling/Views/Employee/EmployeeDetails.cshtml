@model EmployeeHandling.Dto.EmployeeModel.EmployeeResponseDto

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container mt-5">
    <div class="card shadow-lg rounded-4 border-0">
        <div class="card-header bg-gradient-primary text-white d-flex align-items-center justify-content-between">
            <h4 class="mb-0"><i class="bi bi-person-circle me-2"></i> Employee Details</h4>
            <span class="badge bg-light text-primary fs-6">@Model.Department</span>
        </div>

        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3">
                        <h6 class="text-muted"><i class="bi bi-person me-1"></i> Name</h6>
                        <p class="mb-1">@Model.FirstName @Model.OtherName @Model.LastName</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3">
                        <h6 class="text-muted"><i class="bi bi-gender-ambiguous me-1"></i> Gender</h6>
                        <p class="mb-1">@Model.Gender</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3">
                        <h6 class="text-muted"><i class="bi bi-envelope me-1"></i> Email</h6>
                        <p class="mb-1">@Model.Email</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3">
                        <h6 class="text-muted"><i class="bi bi-phone me-1"></i> Phone</h6>
                        <p class="mb-1">@Model.PhoneNumber</p>
                    </div>
                </div>
                <div class="col-12">
                    <div class="p-3 bg-light rounded-3">
                        <h6 class="text-muted"><i class="bi bi-geo-alt me-1"></i> Address</h6>
                        <p class="mb-0">@Model.Address</p>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-end gap-2">
                <a asp-action="EditEmployee" asp-route-id="@Model.Id" class="btn btn-warning shadow-sm">
                    <i class="bi bi-pencil-square me-1"></i> Edit
                </a>

                <a asp-action="RearPage" asp-controller="Employee" class="btn btn-secondary shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #4e73df, #224abe);
    }

    .card-body h6 {
        font-weight: 600;
        font-size: 0.9rem;
    }

    .card-body p {
        font-size: 1rem;
        margin-bottom: 0;
    }

    .btn i {
        vertical-align: middle;
    }
</style>
